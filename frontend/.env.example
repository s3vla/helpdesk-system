# Copie este arquivo para ".env" (já está no .gitignore) se precisar
# apontar pra uma API rodando em outro endereço além do padrão.
# Sem esse arquivo, o frontend já assume http://localhost:3000 sozinho
# (ver src/services/apiClient.js) — só crie o .env se precisar mudar isso.

VITE_API_URL=http://localhost:3000
