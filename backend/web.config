<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuração de hospedagem via IIS + iisnode. Só infraestrutura — nenhuma
  regra de negócio mora aqui, e nada nesse arquivo decide rota nenhuma:
  quem decide é o Nest (setGlobalPrefix('api') em main.ts + exclude do
  ServeStaticModule em app.module.ts). O <rewrite> abaixo manda TODA
  requisição pro processo Node sem exceção — não existe caminho aqui que
  sirva arquivo estático direto pelo IIS, de propósito, já que quem serve
  o build do frontend também é o ServeStaticModule, não o IIS.

  Variáveis de ambiente (DATABASE_URL, JWT_SECRET etc.) NÃO ficam aqui —
  ver DEPLOY-IIS.md, seção "Application Pool": o diretório de trabalho do
  processo Node sob iisnode não é garantidamente backend/ (pode ser
  backend/dist/), então backend/.env pode não ser encontrado. A forma
  confiável é configurar essas variáveis direto no Application Pool do
  IIS, que vira process.env pro Node não importa o diretório de trabalho.
-->
<configuration>
  <system.webServer>
    <!-- Registra o iisnode como o handler que processa dist/main.js —
         é o ponto de entrada compilado (nest build), o mesmo arquivo que
         "node dist/main.js" já roda hoje manualmente. -->
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- IIS por padrão substitui qualquer resposta de erro (4xx/5xx) pela
         própria página HTML de erro genérica — isso quebraria toda
         resposta JSON de erro da API (ex: 401 do ValidationPipe, 403 do
         RolesGuard), que o frontend espera poder fazer .json() e ler
         `message`. PassThrough deixa a resposta que o Node mandou passar
         intacta. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Toda requisição, sem exceção, vira dist/main.js pro IIS —
         satisfaz só o roteamento INTERNO do IIS (precisa de um arquivo
         físico pra escolher o handler iisnode). O iisnode repassa a
         requisição ORIGINAL (URL, método, headers, corpo) pro processo
         Node por trás — o Express dentro do Nest continua enxergando
         GET /api/chamados, GET /assets/x.js etc. exatamente como
         enxerga rodando "node dist/main.js" na mão. Sem condição
         nenhuma (nada de IsFile/negate) — de propósito, pra garantir que
         o IIS nunca tenta servir nada estático por conta própria. -->
    <rewrite>
      <rules>
        <rule name="TudoParaNode" stopProcessing="true">
          <!-- ".*" (não "/*"): o URL Rewrite usa sintaxe de regex por
               padrão (ECMAScript) e testa contra o path SEM a barra
               inicial — "/*" em regex significaria "zero ou mais barras",
               não "qualquer coisa". ".*" é o "casa com tudo, inclusive
               vazio" de verdade. -->
          <match url=".*" />
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Bloqueio defensivo extra: mesmo com o rewrite acima cobrindo tudo,
         garante que essas pastas/arquivos nunca sejam servidos
         diretamente pelo IIS em nenhuma circunstância (ex: alguém
         desabilitar o rewrite por engano no futuro). -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment=".env" />
          <add segment="test" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- devErrorsEnabled=false: nunca vazar stack trace do Node pra quem
         está acessando — só loga em disco (logDirectory). watchedFiles só
         com web.config: reiniciar o processo Node a cada deploy é uma
         ação deliberada (reiniciar o site pelo IIS Manager, ver
         DEPLOY-IIS.md), não algo automático a cada arquivo tocado em
         dist/ — evita reinício no meio de uma requisição em andamento
         durante um deploy. -->
    <iisnode
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      watchedFiles="web.config"
    />
  </system.webServer>
</configuration>
