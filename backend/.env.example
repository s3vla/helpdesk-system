# Copie este arquivo para ".env" (que já está no .gitignore) e preencha os
# valores localmente. Nenhum valor real deve existir neste arquivo, só as
# chaves — ele É versionado para documentar quais variáveis existem.

PORT=3000

# Lista separada por vírgula das origens que podem chamar essa API.
# Nunca usar "*" — nem em dev.
CORS_ORIGIN=http://localhost:5173

# "true" só quando o servidor estiver de fato atrás de HTTPS (certificado
# configurado) — liga a diretiva `upgrade-insecure-requests` do CSP
# (helmet), que faz o navegador reescrever toda requisição da página pra
# HTTPS. Em HTTP puro (fase de teste, sem certificado ainda) isso quebra o
# carregamento dos assets do frontend — deixe "false" até o certificado
# entrar. Ver main.ts.
HTTPS_ATIVO=false

# Conexão com o Postgres (formato: postgresql://usuario:senha@host:porta/banco).
# Banco vazio? Rode as migrations antes de subir a API pela primeira vez —
# ver README, seção "Banco de dados / Migrations".
DATABASE_URL=postgresql://usuario:senha@localhost:5432/empresa_exemplo_helpdesk

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório longo,
# por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# TAMBÉM é a origem da chave que criptografa Tarefa/Anotação em repouso
# (ver README, seção "Criptografia de campo") — trocar este valor sem um
# plano de migração torna essas tabelas permanentemente ilegíveis. NUNCA
# trocar em produção sem ler aquela seção primeiro.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Quem pode ter conta no sistema — lista separada por vírgula (mesmo
# formato de CORS_ORIGIN acima). Sem valor aqui (ausente ou vazia), a API
# recusa subir com um erro explícito na inicialização (ver
# src/config/emails-autorizados.ts) — de propósito, pra nunca ficar no ar
# com a lista vazia em silêncio.
EMAILS_TECNICO_AUTORIZADOS=suporte@empresa-exemplo.com,ti@empresa-exemplo.com
EMAILS_COLABORADOR_AUTORIZADOS=rh@empresa-exemplo.com

# Credenciais dos técnicos criados automaticamente no primeiro start (ver
# src/database/seed.service.ts). Os e-mails têm que bater com
# EMAILS_TECNICO_AUTORIZADOS acima. Só existem em ambiente de
# desenvolvimento — nunca commitadas com valor real.
SEED_TECNICO_1_NOME="Suporte TI"
SEED_TECNICO_1_EMAIL=suporte@empresa-exemplo.com
SEED_TECNICO_1_SENHA=

SEED_TECNICO_2_NOME="TI Empresa Exemplo"
SEED_TECNICO_2_EMAIL=ti@empresa-exemplo.com
SEED_TECNICO_2_SENHA=

# URL pública do frontend — usada só para montar o link "Abrir chamado no
# sistema" nos e-mails de notificação (ver src/email/email.service.ts).
# Sem essa variável, cai no default de dev (http://localhost:5173).
APP_URL=http://localhost:5173

# Credenciais SMTP para envio de e-mail (nodemailer, ver src/email/). Sem
# essas variáveis a API continua funcionando normalmente — o EmailService
# nunca trava a ação principal (abrir chamado, comentar, mudar status) se o
# envio falhar, só loga o erro no servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=

# "true" faz o EmailService só LOGAR "e-mail seria enviado para X", sem
# chamar o SMTP de verdade — as credenciais acima costumam ser as de
# produção de verdade, então NUNCA rodar testes automatizados (Playwright,
# scripts) sem isso ligado, ou cada chamado/comentário/aviso criado durante
# o teste dispara e-mail real pra suporte@/ti@ e colaboradores cadastrados.
# Deixe em branco (ou "false") no seu .env normal de desenvolvimento — só
# ligue em ambientes de teste isolados.
DESABILITAR_ENVIO_EMAIL=false
