# dependências
node_modules/

# build
dist/

# variáveis de ambiente — nunca versionar credenciais reais (nem as de seed/dev)
.env
.env.*.local

# banco de dados local (SQLite) — dados de teste não vão pro Git
*.sqlite
*.sqlite3

# arquivos enviados por upload (print de erro) — conteúdo de usuário, não
# faz parte do código-fonte. .gitkeep mantém a pasta existindo no clone.
uploads/*
!uploads/.gitkeep

# logs e cobertura de testes
*.log
coverage/

# logs do iisnode (criado em runtime pelo IIS, ver web.config/DEPLOY-IIS.md)
iisnode/

# editor / SO
.vscode/
.DS_Store
